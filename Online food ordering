
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CraveKart - Food Ordering System</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #fffaf7;
    color: #29252b;
}

header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 20px 6%;
    background: white;
    box-shadow: 0 3px 15px #0000000d;
    flex-wrap: wrap;
}

header h2, .price {
    color: #e23744;
}

input, textarea {
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
    margin: 7px 0;
    width: 100%;
}

#search {
    width: 250px;
}

button {
    background: #e23744;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 15px;
    cursor: pointer;
    font-weight: bold;
    margin: 3px;
}

button:hover {
    background: #bd2633;
}

.hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 55px 9%;
    background: linear-gradient(120deg, #fff0e8, #fffaf7);
}

.hero h1 {
    font-size: 45px;
    line-height: 1.3;
    margin-bottom: 15px;
}

.hero h1 span {
    color: #e23744;
}

.hero p {
    color: #777;
    line-height: 1.8;
    margin-bottom: 20px;
}

.hero img {
    width: 40%;
    max-width: 400px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 8px solid white;
}

#menu, .dashboard {
    padding: 45px 7%;
}

#menu h2, .dashboard h2 {
    margin-bottom: 22px;
}

.categories {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 25px;
}

.categories button {
    background: white;
    color: #e23744;
    border: 1px solid #f3c5c5;
}

.categories button:hover {
    background: #e23744;
    color: white;
}

.food-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.food-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px #0000000d;
}

.food-card img {
    width: 100%;
    height: 170px;
    object-fit: cover;
}

.food-info {
    padding: 15px;
}

.food-info h3 {
    margin-bottom: 10px;
}

.food-info p {
    color: #777;
    font-size: 13px;
    margin-bottom: 12px;
    line-height: 1.5;
}

.food-info .price {
    font-size: 19px;
    font-weight: bold;
}

.food-info button {
    width: 100%;
}

.dashboard {
    background: #fff0e8;
}

.dashboard p {
    margin-bottom: 15px;
}

footer {
    background: #28242a;
    color: white;
    text-align: center;
    padding: 25px;
    line-height: 2;
}

footer h2 {
    color: #ff626c;
}

.modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: #0009;
    align-items: center;
    justify-content: center;
    padding: 15px;
    overflow-y: auto;
}

.modal-box {
    background: white;
    width: 100%;
    max-width: 460px;
    padding: 25px;
    border-radius: 16px;
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
}

.modal-box h2 {
    color: #e23744;
    margin-bottom: 15px;
}

.close {
    float: right;
    padding: 6px 10px;
}

.modal-box form button {
    width: 100%;
    margin-top: 10px;
}

.cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 12px 0;
    border-bottom: 1px solid #eee;
    font-size: 13px;
}

.cart-item button {
    padding: 7px;
}

.modal-box label {
    display: inline-block;
    margin: 8px 0;
}

.modal-box label input[type="radio"] {
    width: auto;
}

.order-card {
    background: #fff4ef;
    padding: 15px;
    border-radius: 10px;
    margin: 12px 0;
    font-size: 13px;
    line-height: 1.8;
}

.order-card select {
    padding: 8px;
    border-radius: 6px;
    border: 1px solid #ddd;
}

.success {
    text-align: center;
}

.success h1 {
    font-size: 50px;
    margin: 15px;
}

.success p {
    margin: 12px 0;
}

@media(max-width: 900px) {
    .food-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media(max-width: 600px) {
    header {
        padding: 15px;
    }

    #search {
        width: 100%;
    }

    .hero {
        flex-direction: column;
        text-align: center;
        padding: 35px 20px;
    }

    .hero h1 {
        font-size: 34px;
    }

    .hero img {
        width: 80%;
    }

    #menu, .dashboard {
        padding: 30px 15px;
    }

    .food-grid {
        gap: 12px;
    }

    .food-card img {
        height: 125px;
    }

    .food-info {
        padding: 10px;
    }

    .food-info h3 {
        font-size: 14px;
    }

    .food-info button {
        padding: 10px 5px;
    }
}

@media(max-width: 350px) {
    .food-grid {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

<body>

<header>
    <h2>🍔 CraveKart</h2>
    <input type="text" id="search" placeholder="Search food...">
    <button onclick="showCart()">🛒 Cart (<span id="count">0</span>)</button>
    <button onclick="showLogin()">Login / Sign Up</button>
</header>

<section class="hero">
    <div>
        <h1>Your Cravings,<br><span>Our Command!</span></h1>
        <p>Discover delicious food from your favourite restaurants.</p>
        <button onclick="document.getElementById('menu').scrollIntoView()">
            Explore Food
        </button>
    </div>
    <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=700&q=80" alt="Pizza">
</section>

<section id="menu">
    <h2>Explore Our Menu 🍽️</h2>

    <div class="categories">
        <button onclick="filterFood('All')">All</button>
        <button onclick="filterFood('Biryani')">🍛 Biryani</button>
        <button onclick="filterFood('Pizza')">🍕 Pizza</button>
        <button onclick="filterFood('Burger')">🍔 Burger</button>
        <button onclick="filterFood('South Indian')">🥞 South Indian</button>
        <button onclick="filterFood('Dessert')">🍰 Desserts</button>
        <button onclick="filterFood('Drinks')">🥤 Drinks</button>
    </div>

    <div class="food-grid" id="foodGrid"></div>
</section>

<section class="dashboard">
    <h2>Restaurant Dashboard 🧑‍🍳</h2>
    <p>Manage customer orders and update order status.</p>
    <button onclick="showDashboard()">Manage Orders</button>
    <div id="ordersList"></div>
</section>

<footer>
    <h2>🍔 CraveKart</h2>
    <p>Made with ❤️ for food lovers</p>
    <p>Online Food Ordering System | Student Project</p>
</footer>

<!-- CART MODAL -->
<div class="modal" id="cartModal">
    <div class="modal-box">
        <button class="close" onclick="closeModal('cartModal')">✕</button>
        <h2>🛒 Your Cart</h2>
        <div id="cartItems"></div>
        <h3>Subtotal: ₹<span id="subtotal">0</span></h3>
        <p>Delivery: ₹<span id="delivery">0</span></p>
        <h2>Total: ₹<span id="total">0</span></h2>
        <button onclick="checkout()">Proceed to Checkout</button>
    </div>
</div>

<!-- LOGIN MODAL -->
<div class="modal" id="loginModal">
    <div class="modal-box">
        <button class="close" onclick="closeModal('loginModal')">✕</button>
        <h2>Welcome to CraveKart ❤️</h2>
        <form id="loginForm">
            <input id="name" placeholder="Full Name" required>
            <input id="email" type="email" placeholder="Email Address" required>
            <input id="password" type="password" placeholder="Password" required>
            <button type="submit">Register / Login</button>
        </form>
        <p id="loginMessage"></p>
    </div>
</div>

<!-- CHECKOUT MODAL -->
<div class="modal" id="checkoutModal">
    <div class="modal-box">
        <button class="close" onclick="closeModal('checkoutModal')">✕</button>
        <h2>Checkout 💳</h2>
        <form id="checkoutForm">
            <input id="deliveryName" placeholder="Your Name" required>
            <textarea id="address" placeholder="Delivery Address" required></textarea>
            <input id="phone" type="tel" placeholder="10-digit Phone Number"
                   pattern="[0-9]{10}" maxlength="10" required>

            <h3>Select Payment Method</h3>
            <label><input type="radio" name="payment" value="UPI" checked> UPI</label><br>
            <label><input type="radio" name="payment" value="Card"> Credit / Debit Card</label><br>
            <label><input type="radio" name="payment" value="Cash on Delivery"> Cash on Delivery</label>

            <h3>Amount: ₹<span id="checkoutTotal">0</span></h3>
            <button type="submit">Place Order</button>
        </form>
        <small>Demo only. No real payment is processed.</small>
    </div>
</div>

<!-- SUCCESS MODAL -->
<div class="modal" id="successModal">
    <div class="modal-box success">
        <h1>✅</h1>
        <h2>Order Placed Successfully!</h2>
        <p>Thank you for ordering with CraveKart ❤️</p>
        <p>Your delicious food is being prepared!</p>
        <div id="orderDetails"></div>
        <button onclick="closeModal('successModal')">Continue Shopping</button>
    </div>
</div>

<!-- RESTAURANT ORDERS MODAL -->
<div class="modal" id="dashboardModal">
    <div class="modal-box">
        <button class="close" onclick="closeModal('dashboardModal')">✕</button>
        <h2>Restaurant Orders 🧑‍🍳</h2>
        <div id="allOrders"></div>
    </div>
</div>

<script>
const foods = [
    {
        id: 1, name: "Chicken Biryani", category: "Biryani",
        price: 220,
        image: "https://images.unsplash.com/photo-1563379091339-03246963d96c?auto=format&fit=crop&w=500&q=80",
        description: "Delicious aromatic chicken biryani"
    },
    {
        id: 2, name: "Veg Pizza", category: "Pizza",
        price: 249,
        image: "https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=500&q=80",
        description: "Cheesy pizza with fresh vegetables"
    },
    {
        id: 3, name: "Cheese Burger", category: "Burger",
        price: 169,
        image: "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=500&q=80",
        description: "Juicy burger with melted cheese"
    },
    {
        id: 4, name: "Masala Dosa", category: "South Indian",
        price: 99,
        image: "https://images.unsplash.com/photo-1668236543090-82eba5ee5976?auto=format&fit=crop&w=500&q=80",
        description: "Crispy dosa with potato masala"
    },
    {
        id: 5, name: "Paneer Butter Masala", category: "South Indian",
        price: 190,
        image: "https://images.unsplash.com/photo-1631452180519-c014fe946bc7?auto=format&fit=crop&w=500&q=80",
        description: "Creamy paneer curry"
    },
    {
        id: 6, name: "Chocolate Cake", category: "Dessert",
        price: 129,
        image: "https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=500&q=80",
        description: "Rich chocolate cake"
    },
    {
        id: 7, name: "Cold Coffee", category: "Drinks",
        price: 119,
        image: "https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=500&q=80",
        description: "Refreshing chilled coffee"
    },
    {
        id: 8, name: "French Fries", category: "Burger",
        price: 89,
        image: "https://images.unsplash.com/photo-1573080496219-bb080dd4f877?auto=format&fit=crop&w=500&q=80",
        description: "Crispy golden French fries"
    }
];

let cart = [];
let orders = [];
let currentCategory = "All";

function displayFood(list = foods) {
    document.getElementById("foodGrid").innerHTML = list.map(food => `
        <div class="food-card">
            <img src="${food.image}" alt="${food.name}">
            <div class="food-info">
                <h3>${food.name}</h3>
                <p>${food.description}</p>
                <p class="price">₹${food.price}</p>
                <button onclick="addToCart(${food.id})">+ Add to Cart</button>
            </div>
        </div>
    `).join("");
}

function filterFood(category) {
    currentCategory = category;
    const keyword = document.getElementById("search").value.toLowerCase();

    displayFood(foods.filter(food =>
        (category === "All" || food.category === category) &&
        food.name.toLowerCase().includes(keyword)
    ));
}

document.getElementById("search").addEventListener("input", function() {
    const keyword = this.value.toLowerCase();

    displayFood(foods.filter(food =>
        food.name.toLowerCase().includes(keyword) &&
        (currentCategory === "All" || food.category === currentCategory)
    ));
});

function addToCart(id) {
    const food = foods.find(item => item.id === id);
    const existing = cart.find(item => item.id === id);

    if (existing) {
        existing.quantity++;
    } else {
        cart.push({...food, quantity: 1});
    }

    updateCart();
    alert(food.name + " added to cart!");
}

function updateCart() {
    document.getElementById("count").textContent =
        cart.reduce((sum, item) => sum + item.quantity, 0);

    document.getElementById("cartItems").innerHTML =
        cart.length === 0 ? "<p>Your cart is empty!</p>" :
        cart.map(item => `
            <div class="cart-item">
                <div>
                    <b>${item.name}</b><br>
                    ₹${item.price} × ${item.quantity}
                </div>
                <div>
                    <button onclick="changeQuantity(${item.id},-1)">−</button>
                    <button onclick="changeQuantity(${item.id},1)">+</button>
                    <button onclick="removeItem(${item.id})">Remove</button>
                </div>
            </div>
        `).join("");

    const subtotal = cart.reduce(
        (sum, item) => sum + item.price * item.quantity, 0
    );

    const delivery = subtotal === 0 ? 0 : subtotal >= 499 ? 0 : 30;

    document.getElementById("subtotal").textContent = subtotal;
    document.getElementById("delivery").textContent =
        delivery === 0 && subtotal > 0 ? "FREE" : delivery;
    document.getElementById("total").textContent = subtotal + delivery;
    document.getElementById("checkoutTotal").textContent = subtotal + delivery;
}

function changeQuantity(id, amount) {
    const item = cart.find(food => food.id === id);

    if (item) {
        item.quantity += amount;
        if (item.quantity <= 0) {
            cart = cart.filter(food => food.id !== id);
        }
    }

    updateCart();
}

function removeItem(id) {
    cart = cart.filter(food => food.id !== id);
    updateCart();
}

function showCart() {
    updateCart();
    document.getElementById("cartModal").style.display = "flex";
}

function showLogin() {
    document.getElementById("loginModal").style.display = "flex";
}

function closeModal(id) {
    document.getElementById(id).style.display = "none";
}

document.getElementById("loginForm").addEventListener("submit", function(e) {
    e.preventDefault();

    const name = document.getElementById("name").value.trim();

    document.getElementById("loginMessage").textContent =
        "Welcome, " + name + "! Registration successful.";

    this.reset();
    setTimeout(() => closeModal("loginModal"), 1200);
});

function checkout() {
    if (cart.length === 0) {
        alert("Please add food to your cart first!");
        return;
    }

    closeModal("cartModal");
    document.getElementById("checkoutModal").style.display = "flex";
}

document.getElementById("checkoutForm").addEventListener("submit", function(e) {
    e.preventDefault();

    if (cart.length === 0) {
        alert("Your cart is empty!");
        return;
    }

    const name = document.getElementById("deliveryName").value.trim();
    const address = document.getElementById("address").value.trim();
    const phone = document.getElementById("phone").value.trim();
    const payment = document.querySelector('input[name="payment"]:checked').value;

    const subtotal = cart.reduce(
        (sum, item) => sum + item.price * item.quantity, 0
    );

    const delivery = subtotal >= 499 ? 0 : 30;
    const total = subtotal + delivery;

    const order = {
        id: Date.now().toString().slice(-6),
        name, address, phone, payment, total,
        status: "Order Received",
        items: cart.map(item => ({
            name: item.name,
            quantity: item.quantity
        }))
    };

    orders.push(order);

    document.getElementById("orderDetails").innerHTML = `
        <div class="order-card">
            <p><b>Order ID:</b> #${order.id}</p>
            <p><b>Customer:</b> ${order.name}</p>
            <p><b>Phone:</b> ${order.phone}</p>
            <p><b>Address:</b> ${order.address}</p>
            <p><b>Food:</b> ${order.items.map(
                item => item.name + " × " + item.quantity
            ).join(", ")}</p>
            <p><b>Total:</b> ₹${order.total}</p>
            <p><b>Payment:</b> ${order.payment}</p>
            <p><b>Status:</b> ${order.status}</p>
            <small>${payment === "Cash on Delivery"
                ? "Pay when your food arrives."
                : "Demo only: no real payment was processed."}</small>
        </div>
    `;

    cart = [];
    updateCart();
    displayOrders();
    closeModal("checkoutModal");
    document.getElementById("successModal").style.display = "flex";
    this.reset();
});

function showDashboard() {
    displayOrders();
    document.getElementById("dashboardModal").style.display = "flex";
}

function displayOrders() {
    const html = orders.length === 0
        ? "<p>No orders received yet.</p>"
        : orders.map(order => `
            <div class="order-card">
                <h3>Order #${order.id}</h3>
                <p>Customer: ${order.name}</p>
                <p>Food: ${order.items.map(
                    item => item.name + " × " + item.quantity
                ).join(", ")}</p>
                <p>Total: ₹${order.total}</p>
                <p>Address: ${order.address}</p>
                <p>Payment: ${order.payment}</p>
                <label>Order Status:</label>
                <select onchange="updateStatus('${order.id}', this.value)">
                    ${["Order Received", "Preparing", "Out for Delivery",
                       "Delivered", "Cancelled"].map(status =>
                        `<option value="${status}"
                            ${order.status === status ? "selected" : ""}>
                            ${status}
                        </option>`
                    ).join("")}
                </select>
                <p>Current Status: <b>${order.status}</b></p>
            </div>
        `).join("");

    document.getElementById("allOrders").innerHTML = html;
    document.getElementById("ordersList").innerHTML = html;
}

function updateStatus(id, status) {
    const order = orders.find(item => item.id === id);

    if (order) {
        order.status = status;
        displayOrders();
        alert("Order status updated to: " + status);
    }
}

displayFood();
updateCart();
</script>

</body>
</html>
